@model List<RaceDay.Web.Services.EventDto>

@{
    ViewData["Title"] = "Manage Events";
}

<h2>Manage Events</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<p>
    <a asp-controller="Organiser"
       asp-action="CreateEvent"
       class="btn btn-primary">
        Create New Event
    </a>
</p>

@if (Model != null && Model.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Event Name</th>
                <th>Date</th>
                <th>Location</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.EventName</td>
                    <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                    <td>@item.Location</td>
                    <td>@item.Status</td>
                    <td>
                        <a asp-controller="Organiser"
                           asp-action="EditEvent"
                           asp-route-id="@item.EventID"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <form asp-controller="Organiser"
                              asp-action="DeleteEvent"
                              asp-route-id="@item.EventID"
                              method="post"
                              style="display:inline;"
                              onsubmit="return confirm('Are you sure you want to delete this event?');">

                            <button type="submit" class="btn btn-danger btn-sm">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No events found.</p>
}  